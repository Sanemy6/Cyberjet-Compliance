{
  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=CyberjetCompliance;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Storage": {
    // Questionnaires reçus et exports produits. Surtout pas « data » : Windows
    // ignore la casse, et ce dossier entrerait alors en collision avec le
    // dossier source « Data/ » — les fichiers clients atterriraient au milieu
    // du code, et une règle .gitignore visant l'un exclurait l'autre.
    "DataDirectory": "App_Data"
  },
  "Security": {
    // À true uniquement derrière un reverse proxy qui termine le TLS : impose
    // le flag Secure sur le cookie de session indépendamment de ce que la
    // requête entrante affirme (IsHttps peut être trompé par des en-têtes
    // forwarded mal propagés). Laissé à false ici : le déploiement par défaut
    // est du HTTP simple sur réseau interne.
    "RequireSecureCookies": false,

    // Minutes d'inactivité avant fermeture automatique de la session. Ferme un
    // poste laissé sans surveillance, ce que l'échéance absolue de 30 jours ne
    // fait pas. Mettre 0 désactive le mécanisme — à ne faire qu'en connaissance
    // de cause, la session ne tiendrait alors qu'à cette échéance lointaine.
    "SessionIdleTimeoutMinutes": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
